# Pooled PostgreSQL URL for app traffic; direct URL for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require&schema=public"

# Generate a random value of at least 32 characters for local development.
JWT_SECRET="CHANGE_ME"
PORT=4000
NODE_ENV=development

# Set both before running npm run admin:create or deploying to Render.
ADMIN_USERNAME="Admin"
ADMIN_PASSWORD="Fiba3x3-Admin-2026!"
ADMIN_NAME="Tournament Administrator"

# Optional comma-separated origins when the frontend is hosted separately.
ALLOWED_ORIGINS="http://localhost:5173"
